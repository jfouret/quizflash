# Copy to .env and fill in real values. .env is gitignored.
# Loaded automatically by the app (python-dotenv).

# SQLite by default; Docker uses sqlite:////data/quizdeck.db
DATABASE_URL=sqlite:///./quizdeck.db

# Shared OpenRouter defaults: every X_BASE_URL below falls back to OPENROUTER_BASE_URL
# (default https://openrouter.ai) and every X_API_KEY to OPENROUTER_API_KEY.
# OPENROUTER_BASE_URL=https://openrouter.ai
OPENROUTER_API_KEY=

# OpenRouter Decisions API judge
# JUDGE_BASE_URL=                 # defaults to OPENROUTER_BASE_URL
JUDGE_MODEL=inception/mercury-decide
# JUDGE_API_KEY=                  # defaults to OPENROUTER_API_KEY

# OpenAI-compatible speech-to-text
# STT_BASE_URL=                   # defaults to OPENROUTER_BASE_URL
STT_MODEL=
# STT_API_KEY=                    # defaults to OPENROUTER_API_KEY

# Teacher explanations (chat completions)
# TEACHER_BASE_URL=               # falls back to JUDGE_BASE_URL, then OPENROUTER_BASE_URL
TEACHER_MODEL=
# TEACHER_API_KEY=                # falls back to JUDGE_API_KEY, then OPENROUTER_API_KEY
# VOCAL_MODEL=                    # cheaper model for the vocal-ready pass; defaults to TEACHER_MODEL

# Text-to-speech (OpenRouter /api/v1/audio/speech)
# TTS_BASE_URL=                   # falls back to TEACHER/JUDGE_BASE_URL, then OPENROUTER_BASE_URL
TTS_MODEL=
# TTS_API_KEY=                    # falls back to TEACHER/JUDGE_API_KEY, then OPENROUTER_API_KEY
# TTS_VOICE=alloy

# Sessions. Keep COOKIE_SECURE=1 in production (HTTPS); set 0 only for local http://.
COOKIE_SECURE=1
# SESSION_IDLE_HOURS=168
# SESSION_MAX_HOURS=720

# OpenID Connect. When OIDC_ISSUER is set, SSO is the only login method.
# OIDC_ISSUER=https://idp.example.com/realms/main
# OIDC_CLIENT_ID=quizdeck
# OIDC_CLIENT_SECRET=
# OIDC_ROLE_CLAIM=realm_access.roles
# OIDC_ADMIN_ROLE=quizdeck-admin
# SECRET_KEY=   # required with OIDC: python -c "import secrets; print(secrets.token_urlsafe(32))"
